[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }}"
requires-python = ">=3.12"
dependencies = [
{%- if dependency_source == 'git' %}
    "arch-standard @ git+{{ standard_git_url }}@v{{ arch_standard_version }}",
    "arch-commons @ git+{{ standard_git_url }}@v{{ arch_commons_version }}#subdirectory=packages/arch-commons",
{%- else %}
    "arch-standard=={{ arch_standard_version }}",
    "arch-commons=={{ arch_commons_version }}",
{%- endif %}
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.metadata]
# Harmless for plain version pins; required when dependency_source == 'git',
# where arch-standard and arch-commons are direct git references above.
allow-direct-references = true

[tool.hatch.build.targets.wheel]
# Add "src/commons" here as soon as this project gains its first commons/<module>.py.
# commons/ is a PEP 420 namespace portion that merges with the installed
# arch-commons, so it must NOT have an __init__.py (ARCH-055).
packages = ["src/{{ context_name }}", "src/bootstrap"]

[dependency-groups]
dev = ["pytest>=8", "ruff>=0.6", "mypy>=1.11"]

[tool.ruff]
line-length = 100
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM", "TID"]

[tool.mypy]
strict = true
files = ["src", "tests"]
# src/ is the import root: without these, mypy would name src/{{ context_name }}/... modules
# after their own directory rather than after their package path.
mypy_path = "src"
explicit_package_bases = true

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"
pythonpath = ["src"]
